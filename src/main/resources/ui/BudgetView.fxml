<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.jbudget123039.view.BudgetView">

    <top>
        <ToolBar>
            <Button text="Nuovo Budget" onAction="#handleAddBudget"/>
            <Button text="Modifica Budget" onAction="#handleUpdateBudget"/>
            <Button text="Elimina Budget" onAction="#handleDeleteBudget"/>
            <Button text="Torna al menu" onAction="#handleBackToMain"/>
        </ToolBar>
    </top>

    <center>
        <TableView fx:id="budgetTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="colName" text="Nome" prefWidth="200"/>
                <TableColumn fx:id="colStartDate" text="Data Inizio" prefWidth="150"/>
                <TableColumn fx:id="colEndDate" text="Data Fine" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

            <Label text="Data Inizio:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Data Fine:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </bottom>

</BorderPane>