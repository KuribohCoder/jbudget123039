<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="it.unicam.cs.mpgc.jbudget123039.view.TagHierarchyView" spacing="10" alignment="CENTER" style="-fx-padding: 20;">
    <Label text="Gestione Gerarchia Tag" style="-fx-font-size: 18px;" />
    <TreeView fx:id="tagTreeView" prefHeight="400" />
    <HBox spacing="10">
        <Button text="Aggiungi Tag Radice" onAction="#handleAddRootTag"/>
        <Button text="Aggiungi Sottotag" onAction="#handleAddChildTag"/>
        <Button text="Elimina" onAction="#handleDeleteTag"/>
        <Button text="Torna al Main" onAction="#handleBackToMain"/>
    </HBox>
</VBox>